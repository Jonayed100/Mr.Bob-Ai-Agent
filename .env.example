# ---------------------------------------------------------------
# Mr. Bob settings. Copy this file to .env and fill it in:
#   cp .env.example .env
# Never commit .env to GitHub (it is already in .gitignore).
# ---------------------------------------------------------------

# --- You ---
OWNER_NAME=Jonayed
TIMEZONE=Asia/Dhaka
CITY=Dhaka
LATITUDE=23.8103
LONGITUDE=90.4125

# --- Dashboard ---
# The address you open in the browser. Locally: http://localhost:8000
# Online: https://bob.yourdomain.com  (must match DOMAIN below and Google's redirect URL)
PUBLIC_URL=http://localhost:8000
# Used by Caddy to get a free HTTPS certificate (online only)
DOMAIN=bob.yourdomain.com
# Password to open the dashboard
DASHBOARD_PASSWORD=pick-a-strong-password
# Any long random text. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-a-long-random-string-here

# --- Brain: Claude (paid) ---
# https://console.anthropic.com  ->  API keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# --- Backup brain + backup speech: Groq (free tier) ---
# https://console.groq.com  ->  API keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3

# --- Speech-to-text: OpenAI (paid) ---
# https://platform.openai.com  ->  API keys
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe

# --- Mr. Bob's voice ---
# "openai" = natural, expressive voice (uses OPENAI_API_KEY, about $0.015 per minute of speech)
# "edge"   = free Microsoft neural voices
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
# OpenAI voices: ash, ballad, coral, echo, sage, verse, alloy, nova, onyx, shimmer...
TTS_OPENAI_VOICE=ash
# Bangla: "edge" uses the native Bangladeshi voice below (recommended); "openai" tries OpenAI for Bangla too
TTS_BANGLA_PROVIDER=edge
TTS_USD_PER_MINUTE=0.015
# Free backup voices
TTS_VOICE_ENGLISH=en-GB-RyanNeural
TTS_VOICE_BANGLA=bn-BD-PradeepNeural
TTS_VOICE_BANGLISH=en-IN-PrabhatNeural

# --- Google (Gmail + Calendar) ---
# https://console.cloud.google.com  ->  APIs & Services  ->  Credentials  ->  OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Your phone (WhatsApp + Telegram) ---
# Used to send you WhatsApp alerts and to recognise you on Telegram/WhatsApp
OWNER_PHONE=+8801787361208

# --- Telegram ---
# Talk to @BotFather on Telegram, send /newbot, paste the token here
TELEGRAM_BOT_TOKEN=
# Leave empty. Send /start to your bot and tap "Share my number"; Mr. Bob links your chat automatically.
TELEGRAM_CHAT_ID=

# --- WhatsApp alerts (free, one-way) ---
# Save the CallMeBot number in your contacts (see callmebot.com), send it
# "I allow callmebot to send me messages" from WhatsApp, and paste the API key it replies with.
CALLMEBOT_APIKEY=

# --- WhatsApp chat (optional, two-way) via Meta WhatsApp Cloud API ---
# developers.facebook.com -> My Apps -> Create app -> WhatsApp. See README "WhatsApp chat".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any word you choose; type the same word in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Optional: your Meta app secret, so Mr. Bob only accepts real calls from Meta
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# --- bKash SMS tracking ---
# A long random word. Your phone's SMS forwarder sends to https://YOUR_DOMAIN/api/sms?token=THIS
SMS_WEBHOOK_TOKEN=
BKASH_LOW_BALANCE_BDT=500
BKASH_BIG_AMOUNT_BDT=5000

# --- Timing ---
GMAIL_CHECK_MINUTES=10
CALENDAR_HEADS_UP_MINUTES=30
# 24-hour here (07:00 = 7 AM, 21:30 = 9:30 PM); the app shows 12-hour time everywhere
MORNING_BRIEFING_TIME=07:00
# the night report (saved to Reports and sent to Telegram/WhatsApp)
EVENING_SUMMARY_TIME=21:30

# --- Money (for the cost card) ---
MONTHLY_BUDGET_BDT=2700
SERVER_COST_BDT=1300
DOMAIN_COST_BDT_PER_MONTH=150
USD_TO_BDT=122
VAT_RATE=0.15
CLAUDE_INPUT_USD_PER_MTOK=1.0
CLAUDE_OUTPUT_USD_PER_MTOK=5.0
STT_USD_PER_MINUTE=0.003
