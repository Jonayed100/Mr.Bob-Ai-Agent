# ---------------------------------------------------------------
# Mr. Bob settings. Copy this file to .env and fill it in:
#   cp .env.example .env
# Never commit .env to GitHub (it is already in .gitignore).
# ---------------------------------------------------------------

# --- You ---
OWNER_NAME=Jonayed
TIMEZONE=Asia/Dhaka
CITY=Dhaka
LATITUDE=23.8103
LONGITUDE=90.4125

# --- Dashboard ---
# The address you open in the browser. Locally: http://localhost:8000
# Online: https://bob.yourdomain.com  (must match DOMAIN below and Google's redirect URL)
PUBLIC_URL=http://localhost:8000
# Used by Caddy to get a free HTTPS certificate (online only)
DOMAIN=bob.yourdomain.com
# Password to open the dashboard
DASHBOARD_PASSWORD=pick-a-strong-password
# Any long random text. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-a-long-random-string-here

# --- Brain: Claude (paid) ---
# https://console.anthropic.com  ->  API keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# --- Backup brain + backup speech: Groq (free tier) ---
# https://console.groq.com  ->  API keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3

# --- Speech-to-text: OpenAI (paid) ---
# https://platform.openai.com  ->  API keys
OPENAI_API_KEY=
STT_MODEL=gpt-4o-mini-transcribe

# --- Mr. Bob's voice (free Microsoft Edge voices) ---
TTS_VOICE_ENGLISH=en-GB-RyanNeural
TTS_VOICE_BANGLA=bn-BD-PradeepNeural
TTS_VOICE_BANGLISH=en-IN-PrabhatNeural

# --- Google (Gmail + Calendar) ---
# https://console.cloud.google.com  ->  APIs & Services  ->  Credentials  ->  OAuth client ID (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram ---
# Talk to @BotFather on Telegram, send /newbot, paste the token here
TELEGRAM_BOT_TOKEN=
# Leave empty at first. Send /start to your bot and it will tell you this number.
TELEGRAM_CHAT_ID=

# --- Timing ---
GMAIL_CHECK_MINUTES=10
CALENDAR_HEADS_UP_MINUTES=30
MORNING_BRIEFING_TIME=07:00
EVENING_SUMMARY_TIME=21:30

# --- Money (for the cost card) ---
MONTHLY_BUDGET_BDT=2700
SERVER_COST_BDT=1300
DOMAIN_COST_BDT_PER_MONTH=150
USD_TO_BDT=122
VAT_RATE=0.15
CLAUDE_INPUT_USD_PER_MTOK=1.0
CLAUDE_OUTPUT_USD_PER_MTOK=5.0
STT_USD_PER_MINUTE=0.003
